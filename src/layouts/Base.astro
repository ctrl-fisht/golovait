---
interface Props {
  title: string;
  description: string;
  image?: string;
}
import "../styles/global.css";
const { title, description, image = "/og.png" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const fullTitle = isHome && title === "айти голова" ? title : `${title} — айти голова`;
const ogType = pathname.startsWith("/blog/") && pathname !== "/blog" && pathname !== "/blog/" ? "article" : "website";
---
<!doctype html>
<html lang="ru" class="dark">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="айти голова" />
<meta property="og:locale" content="ru_RU" />
<meta property="og:type" content={ogType} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />
<meta name="theme-color" content="#0b0e14" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/ava.jpg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "айти голова",
  url: Astro.site?.toString() ?? "https://golovait.ru/",
  inLanguage: "ru-RU",
  publisher: {
    "@type": "Organization",
    name: "айти голова",
    url: Astro.site?.toString() ?? "https://golovait.ru/",
    logo: { "@type": "ImageObject", url: new URL("/ava.jpg", Astro.site).toString() }
  }
})}></script>
</head>
<body class="bg-[#0b0e14] text-slate-100 antialiased min-h-screen flex flex-col" style="font-family:Inter,system-ui">
<header class="sticky top-0 z-40 bg-[#0b0e14]/80 backdrop-blur border-b border-white/10">
  <div class="max-w-[1120px] mx-auto px-4 h-[56px] flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 font-extrabold" style="font-family:Manrope">
      <img src="/ava.jpg" alt="айти голова" width="32" height="32" class="w-8 h-8 rounded-xl object-cover border border-white/10" loading="eager" />
      <span class="tracking-tight">айти голова</span>
    </a>
    <nav class="hidden md:flex items-center gap-5 text-[14px] font-medium">
      <a href="/" class="hover:text-sky-400">Главная</a>
      <a href="/blog" class="hover:text-sky-400">Статьи</a>
    </nav>
    <div class="flex items-center gap-2">
      <a href="https://t.me/golovait" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white text-slate-900 text-[13px] font-semibold">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2.5a9.5 9.5 0 0 0-9.48 9.08A9.5 9.5 0 0 0 12 22.5a9.5 9.5 0 0 0 9.48-10.92A9.5 9.5 0 0 0 12 2.5Zm4.6 7.1-1.56 7.36c-.12.54-.44.67-.89.42l-2.47-1.82-1.19 1.14c-.13.13-.24.24-.5.24l.18-2.55 4.66-4.21c.2-.18-.05-.28-.31-.1l-5.76 3.63-2.48-.77c-.54-.17-.55-.54.11-.8l9.68-3.73c.45-.16.84.1.69.8Z" fill="currentColor" opacity=".95"/><path d="M8.1 12.1c1.2-.74 2.48-1.52 4-2.46l-3.4 3.08-.6 2.9.9-1.1 1.2-1.15-1.6-1.18Z" fill="white" opacity=".9"/></svg>
        Telegram Канал
      </a>
    </div>
  </div>
</header>
<div id="progress" class="fixed top-[56px] left-0 h-[3px] w-0 bg-gradient-to-r from-sky-500 to-violet-500 z-50"></div>
<main class="flex-1"><slot /></main>
<div class="h-[64px] md:hidden shrink-0" aria-hidden="true"></div>
<nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-[#0b0e14]/95 backdrop-blur supports-[backdrop-filter]:bg-[#0b0e14]/80 border-t border-white/10" style="padding-bottom: env(safe-area-inset-bottom)">
  <div class="flex max-w-[760px] mx-auto">
    <a href="/" class={`flex-1 flex flex-col items-center justify-center gap-0.5 py-3 text-[11px] font-semibold tracking-wide transition ${pathname === "/" ? "text-white" : "text-slate-400"}`}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-5H9v5H4a1 1 0 0 1-1-1V9.5Z"/></svg>
      <span>Главная</span>
    </a>
    <a href="/blog" class={`flex-1 flex flex-col items-center justify-center gap-0.5 py-3 text-[11px] font-semibold tracking-wide transition ${pathname.startsWith("/blog") ? "text-white" : "text-slate-400"}`}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h10"/><path d="M8 12h10"/><path d="M8 18h10"/><path d="M4 6h.01"/><path d="M4 12h.01"/><path d="M4 18h.01"/></svg>
      <span>Статьи</span>
    </a>
    <a href="https://t.me/golovait" target="_blank" rel="noopener noreferrer" class="flex-1 flex flex-col items-center justify-center gap-0.5 py-3 text-[11px] font-semibold tracking-wide text-sky-400">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2.5a9.5 9.5 0 0 0-9.48 9.08A9.5 9.5 0 0 0 12 22.5a9.5 9.5 0 0 0 9.48-10.92A9.5 9.5 0 0 0 12 2.5Zm4.6 7.1-1.56 7.36c-.12.54-.44.67-.89.42l-2.47-1.82-1.19 1.14c-.13.13-.24.24-.5.24l.18-2.55 4.66-4.21c.2-.18-.05-.28-.31-.1l-5.76 3.63-2.48-.77c-.54-.17-.55-.54.11-.8l9.68-3.73c.45-.16.84.1.69.8Z" fill="currentColor" opacity=".95"/><path d="M8.1 12.1c1.2-.74 2.48-1.52 4-2.46l-3.4 3.08-.6 2.9.9-1.1 1.2-1.15-1.6-1.18Z" fill="white" opacity=".9"/></svg>
      <span>Telegram</span>
    </a>
  </div>
</nav>
<script>
  const bar = document.getElementById('progress');
  addEventListener('scroll', ()=>{
    const h = document.documentElement;
    const p = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
    if(bar) bar.style.width = (isNaN(p)?0:p) + '%';
  }, {passive:true});
</script>
</body>
</html>
