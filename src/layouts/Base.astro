---
interface Props {
  title: string;
  description: string;
  image?: string;
}
import "../styles/global.css";
const { title, description, image = "/og.png" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title} — Golovait</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:type" content="article" />
<meta name="theme-color" content="#0ea5e9" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" />
</head>
<body class="bg-slate-50 text-slate-900 antialiased" style="font-family:Inter,system-ui">
<header class="sticky top-0 z-40 bg-white/80 backdrop-blur border-b border-slate-200">
  <div class="max-w-[1120px] mx-auto px-4 h-[56px] flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 font-extrabold" style="font-family:Manrope">
      <span class="w-8 h-8 grid place-items-center rounded-xl bg-slate-900 text-white text-[14px]">G</span> golovait
      <span class="hidden sm:inline text-slate-400 font-semibold">· гид по ИИ</span>
    </a>
    <nav class="hidden md:flex items-center gap-5 text-[14px] font-medium">
      <a href="/" class="hover:text-accent-600">Главная</a>
      <a href="/blog" class="hover:text-accent-600">Блог</a>
      <a href="/about" class="hover:text-accent-600">О проекте</a>
    </nav>
    <div class="flex items-center gap-2">
      <a href="https://t.me/golovait" class="hidden sm:inline-flex px-3 py-1.5 rounded-full bg-slate-900 text-white text-[13px] font-semibold">ТГ →</a>
      <button id="mnav" class="md:hidden w-8 h-8 grid place-items-center rounded-lg border">☰</button>
    </div>
  </div>
  <div id="mmenu" class="hidden md:hidden border-t bg-white px-4 py-3 flex-col gap-2 text-[14px]">
    <a href="/">Главная</a><a href="/blog">Блог</a><a href="/about">О проекте</a>
  </div>
</header>
<div id="progress" class="fixed top-[56px] left-0 h-[3px] w-0 bg-gradient-to-r from-sky-500 to-violet-500 z-50"></div>
<slot />
<footer class="max-w-[1120px] mx-auto px-4 py-8 text-[12px] text-slate-500 flex justify-between gap-4 border-t mt-8">
  <span>© {new Date().getFullYear()} golovait.ru · Сделано с ИИ</span>
  <a href="/rss.xml">RSS</a>
</footer>
<script>
  const bar = document.getElementById('progress');
  const mnav = document.getElementById('mnav');
  const mmenu = document.getElementById('mmenu');
  mnav?.addEventListener('click', ()=> mmenu?.classList.toggle('hidden'));
  addEventListener('scroll', ()=>{
    const h = document.documentElement;
    const p = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
    if(bar) bar.style.width = (isNaN(p)?0:p) + '%';
  }, {passive:true});
</script>
</body>
</html>
