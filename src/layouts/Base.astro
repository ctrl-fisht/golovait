---
interface Props {
  title: string;
  description: string;
  image?: string;
}
import "../styles/global.css";
const { title, description, image = "/og.png" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ru" class="dark">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title} — айти голова</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:type" content="article" />
<meta name="theme-color" content="#0ea5e9" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" />
<script is:inline>
  (function(){
    try{
      const s = localStorage.getItem('theme');
      const d = s ? s==='dark' : true; // default dark
      document.documentElement.classList.toggle('dark', d);
    }catch{}
  })();
</script>
</head>
<body class="bg-white dark:bg-[#0b0e14] text-slate-900 dark:text-slate-100 antialiased transition-colors" style="font-family:Inter,system-ui">
<header class="sticky top-0 z-40 bg-white/80 dark:bg-[#0b0e14]/80 backdrop-blur border-b border-slate-200 dark:border-white/10">
  <div class="max-w-[1120px] mx-auto px-4 h-[56px] flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 font-extrabold" style="font-family:Manrope">
      <img src="/ava.jpg" alt="айти голова" width="32" height="32" class="w-8 h-8 rounded-xl object-cover border border-slate-200 dark:border-white/10" loading="eager" />
      <span class="tracking-tight">айти голова</span>
    </a>
    <nav class="hidden md:flex items-center gap-5 text-[14px] font-medium">
      <a href="/" class="hover:text-sky-500">Главная</a>
      <a href="/blog" class="hover:text-sky-500">Статьи</a>
    </nav>
    <div class="flex items-center gap-2">
      <button id="theme" aria-label="Переключить тему" class="relative w-[52px] h-[28px] rounded-full border border-slate-200 dark:border-white/10 bg-slate-100 dark:bg-white/10 p-[2px] flex items-center transition-colors">
        <span class="absolute inset-0 flex items-center justify-between px-[5px] text-[11px] pointer-events-none select-none">
          <span>☀️</span><span>🌙</span>
        </span>
        <span id="knob" class="relative w-[22px] h-[22px] rounded-full bg-white dark:bg-white shadow flex items-center justify-center text-[11px] transition-all translate-x-0 dark:translate-x-[24px]">🌙</span>
      </button>
      <a href="https://t.me/golovait" target="_blank" rel="noopener" class="hidden sm:inline-flex px-3 py-1.5 rounded-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-[13px] font-semibold">ТГ →</a>
      <button id="mnav" class="md:hidden w-8 h-8 grid place-items-center rounded-lg border border-slate-200 dark:border-white/10">☰</button>
    </div>
  </div>
  <div id="mmenu" class="hidden md:hidden border-t border-slate-200 dark:border-white/10 bg-white dark:bg-[#0b0e14] px-4 py-3 flex-col gap-2 text-[14px]">
    <a href="/">Главная</a><a href="/blog">Статьи</a><a href="https://t.me/golovait" target="_blank">ТГ канал →</a>
  </div>
</header>
<div id="progress" class="fixed top-[56px] left-0 h-[3px] w-0 bg-gradient-to-r from-sky-500 to-violet-500 z-50"></div>
<slot />
<footer class="max-w-[1120px] mx-auto px-4 py-8 text-[12px] text-slate-500 dark:text-slate-400 flex justify-between gap-4 border-t border-slate-200 dark:border-white/10 mt-8">
  <span>© {new Date().getFullYear()} айти голова · golovait.ru</span>
  <div class="flex gap-3"><a href="/rss.xml">RSS</a><a href="https://t.me/golovait" target="_blank">Telegram</a></div>
</footer>
<script>
  const bar = document.getElementById('progress');
  const mnav = document.getElementById('mnav');
  const mmenu = document.getElementById('mmenu');
  const theme = document.getElementById('theme');
  const knob = document.getElementById('knob');
  function apply(d){
    document.documentElement.classList.toggle('dark', d);
    if(knob) knob.textContent = d ? '🌙' : '☀️';
    try{ localStorage.setItem('theme', d?'dark':'light')}catch{}
  }
  // init
  apply(document.documentElement.classList.contains('dark'));
  mnav?.addEventListener('click', ()=> mmenu?.classList.toggle('hidden'));
  theme?.addEventListener('click', ()=> apply(!document.documentElement.classList.contains('dark')));
  addEventListener('scroll', ()=>{
    const h = document.documentElement;
    const p = h.scrollTop / (h.scrollHeight - h.clientHeight) * 100;
    if(bar) bar.style.width = (isNaN(p)?0:p) + '%';
  }, {passive:true});
</script>
</body>
</html>
