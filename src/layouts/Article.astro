---
import Base from "./Base.astro";
const { title, description, date, tags = [], dateISO, image } = Astro.props;
const seoDescription = description && description.trim().length > 20 ? description : `${title} — гайд по бесплатным ИИ-агентам, роутерам и лимитам на айти голова`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const publishedISO = dateISO ? new Date(dateISO).toISOString() : new Date().toISOString();
const ogImage = image ?? "/og.png";
const blogPostingJson = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: seoDescription,
  datePublished: publishedISO,
  dateModified: publishedISO,
  inLanguage: "ru-RU",
  author: { "@type": "Person", name: "айти голова", url: "https://t.me/golovait" },
  publisher: {
    "@type": "Organization",
    name: "айти голова",
    logo: { "@type": "ImageObject", url: new URL("/ava.jpg", Astro.site).toString() }
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  image: new URL(ogImage, Astro.site).toString(),
  keywords: tags.length ? tags.join(", ") : undefined
};
const breadcrumbJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Главная", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Статьи", item: new URL("/blog", Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: title, item: canonicalUrl }
  ]
};
---
<Base title={title} description={seoDescription} image={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingJson)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)}></script>
  <div class="max-w-[1120px] mx-auto px-4 py-6 lg:flex lg:gap-8 lg:items-start">
    <!-- TOC: desktop only, sticky left -->
    <aside class="hidden lg:block w-[268px] shrink-0 self-start sticky top-[72px]">
      <nav id="toc-nav" class="hidden">
        <div class="rounded-2xl border border-white/[0.14] bg-[#141824] shadow-xl shadow-black/40 p-5">
          <div class="flex items-center gap-2 text-[11px] font-extrabold tracking-widest text-slate-300 uppercase">
            <span class="w-1 h-4 rounded-full bg-sky-500 shrink-0"></span>
            Содержание
          </div>
          <ul id="toc-list" class="mt-4 space-y-1.5 text-[13px] leading-5"></ul>
        </div>
      </nav>
    </aside>

    <main class="flex-1 min-w-0 max-w-[760px] mx-auto lg:mx-0 w-full">
      <div class="flex flex-wrap gap-2 text-[12px] font-semibold tracking-wide uppercase text-slate-400">
        <a href="/blog" class="hover:text-white">← Статьи</a> <span>·</span> <span>{date}</span>
      </div>
      <h1 class="mt-3 text-[28px] md:text-[36px] font-extrabold leading-[1.05] tracking-tight" style="font-family:Manrope">{title}</h1>
      <p class="mt-3 text-[16px] leading-6 text-slate-400">{description}</p>
      {tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {tags.map(tag => (
            <span class="px-2.5 py-1 rounded-full bg-white/10 border border-white/10 text-[11px] font-semibold tracking-wide text-slate-300">{tag}</span>
          ))}
        </div>
      )}
      <article id="article-content" class="prose prose-invert prose-slate max-w-none prose-headings:font-[Manrope] prose-headings:text-white prose-h1:text-[28px] prose-h2:text-[24px] prose-h2:mt-10 prose-h2:mb-4 prose-h2:pb-3 prose-h2:border-b prose-h2:border-white/10 prose-h2:font-extrabold prose-h3:text-[18px] prose-h3:mt-8 prose-h3:mb-3 prose-h3:font-bold prose-p:text-slate-300 prose-p:leading-7 prose-strong:text-white prose-a:text-sky-400 prose-a:no-underline hover:prose-a:text-sky-300 prose-a:font-medium prose-a:cursor-pointer prose-ul:text-slate-300 prose-ol:text-slate-300 prose-blockquote:border-l-4 prose-blockquote:border-sky-500 prose-blockquote:bg-white/[0.04] prose-blockquote:py-3 prose-blockquote:px-4 prose-blockquote:rounded-xl prose-img:rounded-2xl prose-img:border prose-img:border-white/10 prose-img:my-6 prose-code:bg-white/10 prose-code:text-sky-200 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:text-[13px] prose-code:font-normal prose-code:before:content-none prose-code:after:content-none prose-pre:bg-[#0f1117] prose-pre:border prose-pre:border-white/10 mt-6">
        <slot />
      </article>
      <div class="mt-8 p-4 rounded-2xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 flex flex-wrap gap-3 items-center justify-between border border-white/5">
        <div class="flex items-center gap-3">
          <img src="/tg.webp" alt="Telegram" width="40" height="40" class="w-10 h-10 rounded-xl object-cover shrink-0" loading="lazy" />
          <div>
            <div class="font-bold leading-tight" style="font-family:Manrope">Подпишись на телеграм канал, там куча полезного</div>
            <div class="text-sm text-slate-300 dark:text-slate-600">IT · Вайбкодинг · Автоматизация — без воды</div>
          </div>
        </div>
        <a href="https://t.me/golovait" target="_blank" rel="noopener noreferrer" class="shrink-0 px-4 py-2 rounded-full bg-white dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-sm">Telegram Канал →</a>
      </div>
    </main>
  </div>

  <style>
    html { scroll-behavior: smooth; }
    #article-content a {
      text-decoration: none !important;
      cursor: pointer;
    }
    #article-content a:hover {
      text-decoration: none !important;
    }
    #article-content hr {
      height: 1px;
      border: 0;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent);
      margin: 2.5rem 0;
    }
  </style>

  <script>
    const article = document.getElementById('article-content');
    const nav = document.getElementById('toc-nav');
    const list = document.getElementById('toc-list');
    if (article && nav && list) {
      const headings = Array.from(article.querySelectorAll('h2, h3'));
      if (headings.length >= 1) {
        nav.classList.remove('hidden');

        const slugify = (s) => s.toLowerCase().trim()
          .replace(/[^a-z0-9а-яё\s-]/gi, '')
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-')
          .slice(0, 60)
          .replace(/^-|-$/g, '') || 'section';

        const used = new Map();
        const links = [];

        headings.forEach((h) => {
          let base = h.id ? h.id : slugify(h.textContent || 'section');
          let slug = base;
          let i = 1;
          while (used.has(slug) || (document.getElementById(slug) !== null && document.getElementById(slug) !== h)) {
            slug = `${base}-${i++}`;
          }
          used.set(slug, true);
          h.id = slug;
          h.style.scrollMarginTop = '84px';

          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${slug}`;
          a.dataset.slug = slug;
          a.textContent = (h.textContent || '').trim();
          if (h.tagName === 'H3') {
            a.className = 'block py-2 px-3 ml-2 rounded-xl text-[12.5px] leading-4 border border-white/[0.06] bg-white/[0.03] text-slate-400 hover:text-white hover:bg-white/[0.08] hover:border-white/15 transition';
          } else {
            a.className = 'block py-2.5 px-3 rounded-xl font-semibold text-[13px] leading-4 border border-white/[0.06] bg-white/[0.03] text-slate-300 hover:text-white hover:bg-white/[0.08] hover:border-white/15 transition';
          }
          a.addEventListener('click', (e) => {
            e.preventDefault();
            document.getElementById(slug)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.pushState(null, '', `#${slug}`);
            setActive(slug, true);
          });
          li.appendChild(a);
          list.appendChild(li);
          links.push(a);
        });

        // active logic: sticky + visible
        const map = new Map();
        headings.forEach((h, idx) => map.set(h.id, links[idx]));
        let activeId = null;
        const setActive = (id, smoothScrollIntoView = false) => {
          if (activeId === id && !smoothScrollIntoView) return;
          activeId = id;
          links.forEach(l => {
            // reset to base
            if (l.tagName) {
              if (l.dataset.slug && document.querySelector(`h3#${CSS.escape(l.dataset.slug)}`)) {
                l.className = 'block py-2 px-3 ml-2 rounded-xl text-[12.5px] leading-4 border border-white/[0.06] bg-white/[0.03] text-slate-400 hover:text-white hover:bg-white/[0.08] hover:border-white/15 transition';
              } else {
                l.className = 'block py-2.5 px-3 rounded-xl font-semibold text-[13px] leading-4 border border-white/[0.06] bg-white/[0.03] text-slate-300 hover:text-white hover:bg-white/[0.08] hover:border-white/15 transition';
              }
            }
          });
          const a = map.get(id);
          if (a) {
            const isH3 = !!document.querySelector(`h3#${CSS.escape(id)}`);
            if (isH3) {
              a.className = 'block py-2 px-3 ml-2 rounded-xl text-[12.5px] leading-4 border border-sky-500/40 bg-sky-500/15 text-sky-200 font-bold shadow-sm transition';
            } else {
              a.className = 'block py-2.5 px-3 rounded-xl font-extrabold text-[13px] leading-4 border border-white bg-white text-slate-900 shadow-md transition';
            }
            if (smoothScrollIntoView) {
              // keep toc item visible inside nav if overflow
              a.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }
          }
        };

        const getCurrentId = () => {
          let current = headings[0]?.id;
          const offset = 92; // header 56 + gap
          for (const h of headings) {
            if (h.getBoundingClientRect().top - offset <= 0) current = h.id;
            else break;
          }
          return current;
        };

        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            const id = getCurrentId();
            if (id) setActive(id);
            ticking = false;
          });
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);

        // initial
        const hash = location.hash.slice(1);
        if (hash && map.has(hash)) setActive(hash);
        else {
          const id = getCurrentId();
          if (id) setActive(id);
        }
        // also keep IntersectionObserver as fallback for fast jumps
        const obs = new IntersectionObserver((entries) => {
          // only use if near top to avoid flicker, scroll handler is primary
        }, { rootMargin: '-84px 0px -80% 0px', threshold: 0 });
        headings.forEach(h => obs.observe(h));
      }
    }
  </script>
</Base>
