---
import Base from "./Base.astro";
const { title, description, date, tags = [] } = Astro.props;
---
<Base title={title} description={description}>
  <main class="max-w-[760px] mx-auto px-4 py-6">
    <div class="flex flex-wrap gap-2 text-[12px] font-semibold tracking-wide uppercase text-slate-400">
      <a href="/blog" class="hover:text-white">← Статьи</a> <span>·</span> <span>{date}</span>
    </div>
    <h1 class="mt-3 text-[28px] md:text-[36px] font-extrabold leading-[1.05] tracking-tight" style="font-family:Manrope">{title}</h1>
    <p class="mt-3 text-[16px] leading-6 text-slate-400">{description}</p>
    <div class="mt-4 flex gap-2">
      <button id="share" class="px-3 py-1.5 rounded-full border border-slate-200 dark:border-white/10 bg-white dark:bg-white/10 text-[13px] font-semibold">↗ Поделиться</button>
      <button onclick="window.print()" class="px-3 py-1.5 rounded-full border border-slate-200 dark:border-white/10 bg-white dark:bg-white/10 text-[13px] font-semibold">📄 PDF</button>
    </div>
    <article class="prose prose-invert prose-slate max-w-none prose-headings:font-[Manrope] prose-headings:text-white prose-h1:text-[28px] prose-h2:text-[24px] prose-h2:mt-10 prose-h2:mb-4 prose-h2:pb-3 prose-h2:border-b prose-h2:border-white/10 prose-h2:font-extrabold prose-h3:text-[18px] prose-h3:mt-8 prose-h3:mb-3 prose-h3:font-bold prose-p:text-slate-300 prose-p:leading-7 prose-strong:text-white prose-a:text-sky-400 prose-ul:text-slate-300 prose-ol:text-slate-300 prose-blockquote:border-l-4 prose-blockquote:border-sky-500 prose-blockquote:bg-white/[0.04] prose-blockquote:py-3 prose-blockquote:px-4 prose-blockquote:rounded-xl prose-img:rounded-2xl prose-img:border prose-img:border-white/10 prose-img:my-6 mt-6">
      <slot />
    </article>
    <div class="mt-8 p-4 rounded-2xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 flex flex-wrap gap-3 items-center justify-between">
      <div>
        <div class="font-bold" style="font-family:Manrope">Понравилось? Кидай в ТГ — айти голова</div>
        <div class="text-sm text-slate-300 dark:text-slate-600">IT · Вайбкодинг · Автоматизация — без воды</div>
      </div>
      <a href="https://t.me/golovait" target="_blank" class="px-4 py-2 rounded-full bg-white dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-sm">ТГ канал →</a>
    </div>
  </main>
  <script>
    document.getElementById('share')?.addEventListener('click', async()=>{
      const d={title:document.title, url:location.href};
      try{ if(navigator.share) await navigator.share(d); else throw 0; }catch{ await navigator.clipboard.writeText(location.href); const b=document.getElementById('share'); if(b){ b.textContent='Скопировано ✓'; setTimeout(()=> b.textContent='↗ Поделиться',1200)}}
    });
  </script>
</Base>
