---
import Base from "./Base.astro";
const { title, description, date, tags = [], dateISO } = Astro.props;
const seoDescription = description && description.trim().length > 20 ? description : `${title} — гайд по бесплатным ИИ-агентам, роутерам и лимитам на айти голова`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const publishedISO = dateISO ? new Date(dateISO).toISOString() : new Date().toISOString();
const blogPostingJson = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: seoDescription,
  datePublished: publishedISO,
  dateModified: publishedISO,
  inLanguage: "ru-RU",
  author: { "@type": "Person", name: "айти голова", url: "https://t.me/golovait" },
  publisher: {
    "@type": "Organization",
    name: "айти голова",
    logo: { "@type": "ImageObject", url: new URL("/ava.jpg", Astro.site).toString() }
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  image: new URL("/og.png", Astro.site).toString(),
  keywords: tags.length ? tags.join(", ") : undefined
};
const breadcrumbJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Главная", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Статьи", item: new URL("/blog", Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: title, item: canonicalUrl }
  ]
};
---
<Base title={title} description={seoDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingJson)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJson)}></script>
  <main class="max-w-[760px] mx-auto px-4 py-6">
    <div class="flex flex-wrap gap-2 text-[12px] font-semibold tracking-wide uppercase text-slate-400">
      <a href="/blog" class="hover:text-white">← Статьи</a> <span>·</span> <span>{date}</span>
    </div>
    <h1 class="mt-3 text-[28px] md:text-[36px] font-extrabold leading-[1.05] tracking-tight" style="font-family:Manrope">{title}</h1>
    <p class="mt-3 text-[16px] leading-6 text-slate-400">{description}</p>
    {tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {tags.map(tag => (
          <span class="px-2.5 py-1 rounded-full bg-white/10 border border-white/10 text-[11px] font-semibold tracking-wide text-slate-300">{tag}</span>
        ))}
      </div>
    )}
    <article class="prose prose-invert prose-slate max-w-none prose-headings:font-[Manrope] prose-headings:text-white prose-h1:text-[28px] prose-h2:text-[24px] prose-h2:mt-10 prose-h2:mb-4 prose-h2:pb-3 prose-h2:border-b prose-h2:border-white/10 prose-h2:font-extrabold prose-h3:text-[18px] prose-h3:mt-8 prose-h3:mb-3 prose-h3:font-bold prose-p:text-slate-300 prose-p:leading-7 prose-strong:text-white prose-a:text-sky-400 prose-ul:text-slate-300 prose-ol:text-slate-300 prose-blockquote:border-l-4 prose-blockquote:border-sky-500 prose-blockquote:bg-white/[0.04] prose-blockquote:py-3 prose-blockquote:px-4 prose-blockquote:rounded-xl prose-img:rounded-2xl prose-img:border prose-img:border-white/10 prose-img:my-6 prose-code:bg-white/10 prose-code:text-sky-200 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:text-[13px] prose-code:font-normal prose-code:before:content-none prose-code:after:content-none prose-pre:bg-[#0f1117] prose-pre:border prose-pre:border-white/10 mt-6">
      <slot />
    </article>
    <div class="mt-8 p-4 rounded-2xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 flex flex-wrap gap-3 items-center justify-between border border-white/5">
      <div class="flex items-center gap-3">
        <img src="/tg.webp" alt="Telegram" width="40" height="40" class="w-10 h-10 rounded-xl object-cover shrink-0" loading="lazy" />
        <div>
          <div class="font-bold leading-tight" style="font-family:Manrope">Подпишись на телеграм канал, там куча полезного</div>
          <div class="text-sm text-slate-300 dark:text-slate-600">IT · Вайбкодинг · Автоматизация — без воды</div>
        </div>
      </div>
      <a href="https://t.me/golovait" target="_blank" rel="noopener noreferrer" class="shrink-0 px-4 py-2 rounded-full bg-white dark:bg-slate-900 text-slate-900 dark:text-white font-bold text-sm">Telegram Канал →</a>
    </div>
  </main>
</Base>
