---
const { tabs } = Astro.props as { tabs: {label:string, content:string}[] };
---
<div class="my-4 border border-slate-200 dark:border-white/10 rounded-2xl overflow-hidden bg-white dark:bg-white/[0.06]">
  <div class="flex gap-2 p-2 border-b border-slate-200 dark:border-white/10 bg-slate-50 dark:bg-white/[0.04] overflow-x-auto">
    {tabs.map((t,i)=> <button class={`tabbtn px-3 py-1.5 rounded-full border text-[13px] font-semibold whitespace-nowrap ${i===0?'bg-slate-900 dark:bg-white text-white dark:text-slate-900':''}`} data-i={i}>{t.label}</button>)}
  </div>
  <div class="p-4">
    {tabs.map((t,i)=> <div class={`tabpane ${i===0?'':'hidden'}`} data-i={i} set:html={t.content}></div>)}
  </div>
</div>
<script>
  document.querySelectorAll('.tabbtn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const i=btn.getAttribute('data-i');
      document.querySelectorAll('.tabbtn').forEach(b=> b.classList.toggle('bg-slate-900', b.getAttribute('data-i')===i) || b.classList.toggle('text-white', b.getAttribute('data-i')===i));
      document.querySelectorAll('.tabpane').forEach(p=> p.classList.toggle('hidden', p.getAttribute('data-i')!==i));
    });
  });
</script>
