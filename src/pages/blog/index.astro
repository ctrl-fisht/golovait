---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog")).filter(p=>!p.data.draft).sort((a,b)=> b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title="Статьи — айти голова" description="IT, Вайбкодинг, Автоматизация — 1 статья = 1 страница.">
  <div class="max-w-[760px] mx-auto px-4 py-6">
    <h1 class="text-[28px] font-extrabold" style="font-family:Manrope">Статьи</h1>
    <div class="grid gap-3 mt-6">
      {posts.map(p=> (
        <a href={`/blog/${p.id.replace(/\.mdx?$/,'')}`} class="flex justify-between gap-4 py-4 border-b border-slate-200 dark:border-white/10 hover:opacity-80">
          <div>
            <div class="font-semibold leading-tight">{p.data.title}</div>
            <div class="text-sm text-slate-500 dark:text-slate-400 line-clamp-1 mt-1">{p.data.description}</div>
          </div>
          <div class="text-[12px] text-slate-400 whitespace-nowrap pt-1">{p.data.date.toLocaleDateString('ru-RU')}</div>
        </a>
      ))}
    </div>
  </div>
</Base>
