---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog")).filter(p=>!p.data.draft).sort((a,b)=> b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title="Статьи" description="Все статьи про бесплатные ИИ-агенты, вайбкодинг и автоматизацию — гайды по free-claude-code, NVIDIA NIM, opencode и Claude Code на айти голова.">
  <div class="max-w-[760px] mx-auto px-4 py-6">
    <h1 class="text-[28px] font-extrabold" style="font-family:Manrope">Статьи</h1>
    <div class="grid gap-3 mt-6">
      {posts.map(p=> {
        const slug = p.id.replace(/\.mdx?$/,'');
        const thumb = (p.data as any).image ?? '/og.png';
        return (
        <a href={`/blog/${slug}`} class="group flex gap-4 py-4 border-b border-slate-200 dark:border-white/10 hover:opacity-90 transition">
          <img src={thumb} alt={p.data.title} width="96" height="96" loading="lazy" decoding="async" class="w-[88px] h-[88px] sm:w-[104px] sm:h-[72px] rounded-xl object-cover shrink-0 border border-slate-200 dark:border-white/10 bg-white dark:bg-white/[0.04]" />
          <div class="flex-1 min-w-0 flex flex-col">
            <div class="font-semibold leading-tight line-clamp-2 group-hover:text-sky-500 transition">{p.data.title}</div>
            <div class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 mt-1">{p.data.description}</div>
            <div class="text-[12px] text-slate-400 mt-2">{p.data.date.toLocaleDateString('ru-RU')}</div>
          </div>
        </a>
        );
      })}
    </div>
  </div>
</Base>
