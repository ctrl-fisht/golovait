---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
export async function getStaticPaths(){
  const posts = await getCollection("blog");
  const tags = [...new Set(posts.flatMap(p=> p.data.tags||[]))];
  return tags.map(tag=> ({params:{tag}, props:{tag}}));
}
const { tag } = Astro.props;
import { getCollection as gc } from "astro:content";
const all = await gc("blog");
const posts = all.filter(p=> (p.data.tags||[]).includes(tag)).sort((a,b)=> b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title={`#${tag} — айти голова`} description={`Статьи по тегу ${tag}`}>
  <div class="max-w-[1120px] mx-auto px-4 py-6">
    <h1 class="text-[28px] font-extrabold" style="font-family:Manrope">#{tag}</h1>
    <p class="text-slate-600 dark:text-slate-400">Все статьи темы. <a href="/blog" class="text-sky-500">← Все</a></p>
    <div class="grid md:grid-cols-3 gap-4 mt-6">
      {posts.map(p=> (
        <a href={`/blog/${p.id.replace(/\.mdx?$/,'')}`} class="rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-white/[0.06] p-4">
          <div class="text-[11px] font-bold text-sky-500">{p.data.date.toLocaleDateString('ru-RU')}</div>
          <div class="font-bold">{p.data.title}</div>
          <div class="text-sm text-slate-600 dark:text-slate-400 line-clamp-2">{p.data.description}</div>
        </a>
      ))}
    </div>
  </div>
</Base>
