---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog")).sort((a,b)=> b.data.date.valueOf()-a.data.date.valueOf()).slice(0,6);
---
<Base title="айти голова — IT, Вайбкодинг, Автоматизация" description="Коротко про IT без воды: вайбкодинг в потоке, автоматизация рутины, 1 статья = 1 страница с интерактивом.">
  <section class="max-w-[1120px] mx-auto px-4 py-8 grid md:grid-cols-[1.2fr_.8fr] gap-6">
    <div>
      <div class="inline-flex px-2 py-1 rounded-full bg-white dark:bg-white text-slate-900 text-[11px] font-bold tracking-wide">АЙТИ ГОЛОВА · GOLOVAIT.RU</div>
      <h1 class="mt-3 text-[32px] md:text-[42px] font-extrabold leading-[0.95] tracking-tight" style="font-family:Manrope">айти голова <span class="bg-gradient-to-r from-sky-500 to-violet-500 bg-clip-text text-transparent">IT · Вайбкодинг · Авто</span></h1>
      <p class="mt-3 text-slate-600 dark:text-slate-400">Без гида по ИИ. Только 3 темы: IT как ремесло, вайбкодинг в потоке, автоматизация — отдать боту. 1 статья = 1 страница с интерактивом.</p>
      <div class="mt-4 flex gap-2 flex-wrap">
        <a href="/blog/it-kak-ne-sgoret" class="px-4 py-2 rounded-full bg-white text-slate-900 font-bold text-sm">IT</a>
        <a href="/blog/vaybkoding-chto-eto" class="px-4 py-2 rounded-full bg-sky-500 text-white font-bold text-sm">Вайбкодинг</a>
        <a href="/blog/avtomatizatsiya-chto-otdat-botu" class="px-4 py-2 rounded-full border border-slate-200 dark:border-white/10 bg-white dark:bg-white/10 font-semibold text-sm">Автоматизация</a>
      </div>
    </div>
    <div class="rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-white/[0.06] p-4">
      <div class="text-[11px] font-extrabold tracking-widest text-slate-500 dark:text-slate-400">ТЕМАТИКИ</div>
      <ul class="mt-2 grid gap-2 text-sm">
        <li>💻 <b>IT</b> — ремесло, фокус, не выгорать</li>
        <li>🎧 <b>Вайбкодинг</b> — поток, ритуалы, скорость с кайфом</li>
        <li>⚙️ <b>Автоматизация</b> — рутину боту, себе — творчество</li>
      </ul>
      <a href="https://t.me/golovait" target="_blank" class="mt-3 inline-flex px-3 py-1.5 rounded-full bg-slate-900 dark:bg-white text-white dark:text-slate-900 text-[13px] font-bold">ТГ айти голова →</a>
    </div>
  </section>
  <section class="max-w-[1120px] mx-auto px-4">
    <h2 class="text-[18px] font-extrabold" style="font-family:Manrope">Свежие статьи</h2>
    <div class="grid md:grid-cols-3 gap-4 mt-3">
      {posts.map(p=> (
        <a href={`/blog/${p.id.replace(/\.mdx?$/,'')}`} class="rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-white/[0.06] p-4 hover:shadow dark:hover:bg-white/[0.08]">
          <div class="text-[11px] font-bold text-sky-500">{p.data.tags?.[0]?.toUpperCase()} · {p.data.date.toLocaleDateString('ru-RU')}</div>
          <div class="font-bold leading-tight mt-1">{p.data.title}</div>
          <div class="text-sm text-slate-600 dark:text-slate-400 line-clamp-2 mt-1">{p.data.description}</div>
          <div class="mt-2 text-xs text-slate-500">{p.data.tags?.map(t=> '#'+t).join(' ')}</div>
        </a>
      ))}
    </div>
  </section>
</Base>
