---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog")).sort((a,b)=> b.data.date.valueOf()-a.data.date.valueOf()).slice(0,6);
---
<Base title="Golovait — Гид по ИИ для новичков" description="Полный гайд по ИИ с нуля. Карта, промпты, роадмап — за 1 вечер.">
  <section class="max-w-[1120px] mx-auto px-4 py-8 grid md:grid-cols-[1.2fr_.8fr] gap-6">
    <div>
      <div class="inline-flex px-2 py-1 rounded-full bg-slate-900 text-white text-[11px] font-bold tracking-wide">GOLOVAIT · ОБНОВЛЯЕТСЯ</div>
      <h1 class="mt-3 text-[32px] md:text-[40px] font-extrabold leading-[0.95] tracking-tight" style="font-family:Manrope">Полный гайд по ИИ <span class="bg-gradient-to-r from-sky-500 to-violet-500 bg-clip-text text-transparent">для новичков</span></h1>
      <p class="mt-3 text-slate-600">С нуля за 1 вечер. 1 статья = 1 страница с интерактивом: копипаст, табы, конструктор, роадмап. Без воды.</p>
      <div class="mt-4 flex gap-2">
        <a href="/blog/polnyj-gajd-po-ii" class="px-4 py-2 rounded-full bg-slate-900 text-white font-bold text-sm">Начать за 15 мин →</a>
        <a href="/blog" class="px-4 py-2 rounded-full border bg-white font-semibold text-sm">Все статьи</a>
      </div>
    </div>
    <div class="rounded-2xl border bg-white p-4">
      <div class="text-[11px] font-extrabold tracking-widest text-slate-500">ЧТО ВНУТРИ</div>
      <ul class="mt-2 grid gap-2 text-sm">
        <li>✓ Карта ИИ — 5 веток</li><li>✓ 3 сервиса на старт — 0₽</li><li>✓ 5 промптов копипаст</li><li>✓ Роадмап 7/30 дней</li>
      </ul>
    </div>
  </section>
  <section class="max-w-[1120px] mx-auto px-4">
    <h2 class="text-[18px] font-extrabold" style="font-family:Manrope">Свежие статьи</h2>
    <div class="grid md:grid-cols-3 gap-4 mt-3">
      {posts.map(p=> (
        <a href={`/blog/${p.id.replace(/\.mdx?$/,'')}`} class="rounded-2xl border bg-white p-4 hover:shadow">
          <div class="text-[11px] font-bold text-sky-600">{p.data.date.toLocaleDateString('ru-RU')}</div>
          <div class="font-bold leading-tight mt-1">{p.data.title}</div>
          <div class="text-sm text-slate-600 line-clamp-2 mt-1">{p.data.description}</div>
          <div class="mt-2 text-xs text-slate-500">{p.data.tags?.map(t=> '#'+t).join(' ')}</div>
        </a>
      ))}
    </div>
  </section>
</Base>
