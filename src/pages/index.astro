---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog")).sort((a,b)=> b.data.date.valueOf()-a.data.date.valueOf()).slice(0,6);
---
<Base title="айти голова" description="IT, Вайбкодинг, Автоматизация — коротко и по делу.">
  <section class="max-w-[760px] mx-auto px-4 py-12">
    <h1 class="text-[40px] font-extrabold tracking-tight" style="font-family:Manrope">айти голова</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-400">IT · Вайбкодинг · Автоматизация</p>
  </section>
  <section class="max-w-[760px] mx-auto px-4">
    <div class="grid gap-3">
      {posts.map(p=> (
        <a href={`/blog/${p.id.replace(/\.mdx?$/,'')}`} class="group flex justify-between gap-4 py-4 border-b border-slate-200 dark:border-white/10 hover:opacity-80">
          <div>
            <div class="font-semibold leading-tight group-hover:text-sky-500">{p.data.title}</div>
            <div class="text-sm text-slate-500 dark:text-slate-400 line-clamp-1 mt-1">{p.data.description}</div>
          </div>
          <div class="text-[12px] text-slate-400 whitespace-nowrap pt-1">{p.data.date.toLocaleDateString('ru-RU')}</div>
        </a>
      ))}
    </div>
  </section>
</Base>
