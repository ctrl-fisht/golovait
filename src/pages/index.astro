---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
const posts = (await getCollection("blog")).sort((a,b)=> b.data.date.valueOf()-a.data.date.valueOf()).slice(0,6);
---
<Base title="айти голова" description="IT, Вайбкодинг, Автоматизация — коротко и по делу.">
  <section class="max-w-[760px] mx-auto px-4 pt-10 pb-6">
    <div class="flex flex-col sm:flex-row gap-6 items-start sm:items-center">
      <img src="/ava.jpg" alt="айти голова" width="120" height="120" class="w-[112px] h-[112px] rounded-[24px] object-cover border border-white/10 shadow-lg" loading="eager" />
      <div>
        <h1 class="text-[38px] font-extrabold tracking-tight leading-none" style="font-family:Manrope">айти голова</h1>
        <p class="mt-2 text-[15px] leading-6 text-slate-300 max-w-[520px]">
          Пишу про <b class="text-white">IT</b> без воды, <b class="text-white">вайбкодинг</b> в потоке и <b class="text-white">автоматизацию</b> — отдать рутину боту, себе оставить творчество. Коротко, с примерами и интерактивом.
        </p>
        <div class="mt-3 flex gap-2 flex-wrap">
          <a href="/blog" class="px-4 py-1.5 rounded-full bg-white text-slate-900 text-[13px] font-bold">Статьи →</a>
          <a href="https://t.me/golovait" target="_blank" class="px-4 py-1.5 rounded-full border border-white/10 bg-white/10 text-[13px] font-semibold">ТГ канал</a>
        </div>
      </div>
    </div>
    <picture class="block mt-6 rounded-[24px] overflow-hidden border border-white/10 bg-white/[0.04]">
      <source srcset="/hero.avif" type="image/avif" />
      <source srcset="/hero.webp" type="image/webp" />
      <img src="/hero.jpg" alt="айти голова — IT, Вайбкодинг, Автоматизация" width="800" height="450" class="w-full h-auto object-cover" loading="eager" decoding="async" />
    </picture>
    <div class="mt-2 text-[11px] tracking-wide text-slate-500 text-center">айти голова · IT · Вайбкодинг · Автоматизация · golovait.ru</div>
  </section>
  <section class="max-w-[760px] mx-auto px-4">
    <div class="flex items-baseline justify-between">
      <h2 class="text-[13px] font-extrabold tracking-widest text-slate-500 dark:text-slate-400">СВЕЖЕЕ</h2>
      <a href="/blog" class="text-[13px] font-semibold text-sky-500">Все →</a>
    </div>
    <div class="mt-3 grid gap-3">
      {posts.map(p=> (
        <a href={`/blog/${p.id.replace(/\.mdx?$/,'')}`} class="group flex gap-4 p-4 rounded-2xl border border-slate-200 dark:border-white/10 bg-white dark:bg-white/[0.06] hover:bg-slate-50 dark:hover:bg-white/[0.08] transition">
          <div class="flex-1 min-w-0">
            <div class="font-semibold leading-tight group-hover:text-sky-500 line-clamp-2">{p.data.title}</div>
            <div class="text-sm text-slate-500 dark:text-slate-400 line-clamp-2 mt-1">{p.data.description}</div>
            <div class="text-[11px] font-bold tracking-wide text-slate-400 mt-2">{p.data.tags?.[0]?.toUpperCase()} · {p.data.date.toLocaleDateString('ru-RU')}</div>
          </div>
          <div class="hidden sm:block w-7 h-7 rounded-full border border-slate-200 dark:border-white/10 grid place-items-center text-slate-400 group-hover:text-sky-500">→</div>
        </a>
      ))}
    </div>
  </section>
</Base>
